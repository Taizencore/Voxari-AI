# App / Infra
APP_PUBLIC_URL="https://<your-replit-app>.repl.co"
NODE_ENV="development"
DATABASE_URL="postgresql://user:pass@host:5432/db"
JWT_SECRET="change-me"

# Auth: Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SECRET=""

# Telnyx
TELNYX_API_KEY=""
TELNYX_PUBLIC_KEY=""
TELNYX_WEBHOOK_SECRET=""
TELNYX_CONNECTION_ID=""
TELNYX_MESSAGING_PROFILE_ID=""
TELNYX_DEFAULT_COUNTRY="US"

# OpenAI
OPENAI_API_KEY=""
OPENAI_REALTIME_MODEL="gpt-4o-realtime-preview-2024-10-01"

# ElevenLabs
ELEVENLABS_API_KEY=""
ELEVENLABS_DEFAULT_VOICE_ID=""

# Dodo Payments
DODO_PAYMENTS_API_KEY=""
DODO_PAYMENTS_WEBHOOK_SECRET=""
DODO_PAYMENTS_ENV="test"
DODO_SUCCESS_REDIRECT_URL="${APP_PUBLIC_URL}/billing/success"
DODO_CANCEL_REDIRECT_URL="${APP_PUBLIC_URL}/billing/cancel"

# Email/SMS
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
EMAIL_FROM="Voxari Health <no-reply@voxarihealth.com>"
SMS_PROVIDER="telnyx"
